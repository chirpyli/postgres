/* PostgreSQL 版本号数字 */
#undef PG_VERSION_NUM

/* 包含版本号、平台和 C 编译器信息的字符串 */
#undef PG_VERSION_STR

/* 定义为 1 以允许为每个进程单独保存性能分析输出。 */
#undef PROFILE_PID_DIR

/* 如果此常量在你的系统上使用非标准名称，则定义必要的符号。 */
#undef PTHREAD_CREATE_JOINABLE

/* RELSEG_SIZE 是单个磁盘文件中允许的最大块数。因此，单个文件的最大大小
   为 RELSEG_SIZE * BLCKSZ；超过该大小的关系会被分割为多个文件。
   RELSEG_SIZE * BLCKSZ 必须小于操作系统对文件大小的限制。在 32 位操作系统
   中通常为 2 GB 或 4 GB，除非启用了大文件支持。默认情况下，我们将限制
   设为 1 GB，以避免操作系统中任何可能的整数溢出问题。比实际需要更小的
   限制仅意味着我们会将大关系分割为比实际需要更多的分块，因此保守地
   选择较小值似乎更稳妥。建议使用 2 的幂值以在 md.c 中节省几个 CPU 周期，
   但并非强制要求。修改 RELSEG_SIZE 需要重新 initdb。 */
#undef RELSEG_SIZE

/* `long` 的大小（sizeof 计算结果）。 */
#undef SIZEOF_LONG

/* `long long` 的大小（sizeof 计算结果）。 */
#undef SIZEOF_LONG_LONG

/* `off_t` 的大小（sizeof 计算结果）。 */
#undef SIZEOF_OFF_T

/* `size_t` 的大小（sizeof 计算结果）。 */
#undef SIZEOF_SIZE_T

/* `void *` 的大小（sizeof 计算结果）。 */
#undef SIZEOF_VOID_P

/* 如果存在 ANSI C 头文件，则定义为 1。 */
#undef STDC_HEADERS

/* 如果 strerror_r() 返回 int，则定义为 1。 */
#undef STRERROR_R_INT

/* 定义为 1 以使用 ARMv8 CRC 扩展指令。 */
#undef USE_ARMV8_CRC32C

/* 定义为 1 以在运行时检查后使用 ARMv8 CRC 扩展指令。 */
#undef USE_ARMV8_CRC32C_WITH_RUNTIME_CHECK

/* 定义为 1 以构建断言检查。(--enable-cassert) */
#undef USE_ASSERT_CHECKING

/* 定义为 1 以在运行时检查后使用 AVX-512 CRC 算法。 */
#undef USE_AVX512_CRC32C_WITH_RUNTIME_CHECK

/* 定义为 1 以在运行时检查后使用 AVX-512 popcount 指令。 */
#undef USE_AVX512_POPCNT_WITH_RUNTIME_CHECK

/* 定义为 1 以构建 Bonjour 支持。(--with-bonjour) */
#undef USE_BONJOUR

/* 定义为 1 以构建 BSD 认证支持。(--with-bsd-auth) */
#undef USE_BSD_AUTH

/* 定义为 1 以构建 ICU 支持。(--with-icu) */
#undef USE_ICU

/* 定义为 1 以构建注入点支持。(--enable-injection-points) */
#undef USE_INJECTION_POINTS

/* 定义为 1 以构建 LDAP 支持。(--with-ldap) */
#undef USE_LDAP

/* 定义为 1 以构建 libcurl 支持。(--with-libcurl) */
#undef USE_LIBCURL

/* 定义为 1 以构建 NUMA 支持。(--with-libnuma) */
#undef USE_LIBNUMA

/* 定义为 1 以构建 io_uring 支持。(--with-liburing) */
#undef USE_LIBURING

/* 定义为 1 以构建 XML 支持。(--with-libxml) */
#undef USE_LIBXML

/* 定义为 1 以在构建 contrib/xml2 时使用 XSLT 支持。
   (--with-libxslt) */
#undef USE_LIBXSLT

/* 定义为 1 以构建基于 LLVM 的 JIT 支持。(--with-llvm) */
#undef USE_LLVM

/* 定义为 1 以使用 LoongArch CRCC 指令。 */
#undef USE_LOONGARCH_CRC32C

/* 定义为 1 以构建 LZ4 支持。(--with-lz4) */
#undef USE_LZ4

/* 定义为 1 以选择命名 POSIX 信号量。 */
#undef USE_NAMED_POSIX_SEMAPHORES

/* 定义为 1 以构建 OpenSSL 支持。(--with-ssl=openssl) */
#undef USE_OPENSSL

/* 定义为 1 以构建 PAM 支持。(--with-pam) */
#undef USE_PAM

/* 定义为 1 以使用软件 CRC-32C 实现（slicing-by-8）。 */
#undef USE_SLICING_BY_8_CRC32C

/* 定义为 1 以使用 Intel SSE 4.2 CRC 指令。 */
#undef USE_SSE42_CRC32C

/* 定义为 1 以在运行时检查后使用 Intel SSE 4.2 CRC 指令。 */
#undef USE_SSE42_CRC32C_WITH_RUNTIME_CHECK

/* 定义为 1 以在运行时检查后使用 SVE popcount 指令。 */
#undef USE_SVE_POPCNT_WITH_RUNTIME_CHECK

/* 定义为 1 以构建 systemd 支持。(--with-systemd) */
#undef USE_SYSTEMD

/* 定义为 1 以选择 SysV 风格信号量。 */
#undef USE_SYSV_SEMAPHORES

/* 定义为 1 以选择 SysV 风格共享内存。 */
#undef USE_SYSV_SHARED_MEMORY

/* 定义为 1 以选择未命名 POSIX 信号量。 */
#undef USE_UNNAMED_POSIX_SEMAPHORES

/* 定义为 1 以选择 Win32 风格信号量。 */
#undef USE_WIN32_SEMAPHORES

/* 定义为 1 以选择 Win32 风格共享内存。 */
#undef USE_WIN32_SHARED_MEMORY

/* 定义为 1 以构建 ZSTD 支持。(--with-zstd) */
#undef USE_ZSTD

/* 如果处理器最高有效字节在前（如 Motorola 和 SPARC，与 Intel 相反），
   则将 WORDS_BIGENDIAN 定义为 1。 */
#if defined AC_APPLE_UNIVERSAL_BUILD
# if defined __BIG_ENDIAN__
#  define WORDS_BIGENDIAN 1
# endif
#else
# ifndef WORDS_BIGENDIAN
#  undef WORDS_BIGENDIAN
# endif
#endif

/* WAL 文件块大小。此值与 BLCKSZ 不必存在特定关系。
   XLOG_BLCKSZ 必须是 2 的幂，并且如果系统支持 O_DIRECT I/O，
   XLOG_BLCKSZ 必须是直接 I/O 缓冲区对齐要求的倍数，否则直接 I/O 可能
   失败。修改 XLOG_BLCKSZ 需要重新 initdb。 */
#undef XLOG_BLCKSZ



/* 文件偏移的位数，在可设置此项的主机上使用。 */
#undef _FILE_OFFSET_BITS

/* 在某些主机上（如 glibc 2.2）使 fseeko 可见，则定义为 1。 */
#undef _LARGEFILE_SOURCE

/* 在 AIX 风格的主机上为大文件支持而定义。 */
#undef _LARGE_FILES

/* 定义为 `__inline__` 或 `__inline`（如果 C 编译器以此名称调用它），
   如果 'inline' 在任何名称下都不支持，则定义为空。 */
#ifndef __cplusplus
#undef inline
#endif

/* 定义为用于 C99 restrict 支持的关键字，如果不支持则定义为空 */
#undef pg_restrict

/* 定义为等价于 C99 'restrict' 关键字的词，如果不支持则定义为空。
   如果直接支持 restrict，则不要定义。 */
#undef restrict
/* 绕过 Sun C++ 的一个 bug：即使对应的 Sun C 编译器最终会在上一行中
   得到 "#define restrict _Restrict" 或 "#define restrict __restrict__"，
   Sun C++ 也不支持 _Restrict 或 __restrict__。也许 Sun C++ 的某个未来
   版本会支持 restrict；如果是这样，希望它能像 Sun C 一样定义 __RESTRICT。 */
#if defined __SUNPRO_CC && !defined __RESTRICT
# define _Restrict
# define __restrict__
#endif

/* 定义编译器对 `typeof` 的拼写方式。 */
#undef typeof
